# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/

# Claude Code (sessões locais, não devem ir pro repo)
.claude/settings.local.json
.claude/projects/
.claude/sessions/
.claude/shell-snapshots/
.claude/telemetry/
.claude/file-history/
.claude/backups/

# Dependências
node_modules/

# Arquivos temporários
*.log
*.tmp

# Compactados. Costumam ser cópia de algo que já está versionado — subir
# duplica o peso, e o histórico do git não esquece o que entrou uma vez.
*.zip
*.rar
*.7z

# Drop zone do usuário (só o README vai versionado)
projetos/*/dados/*
!projetos/*/dados/README.md

# Fotos de perfil enviadas pelos usuários (dado pessoal — não vai pro repo).
# A pasta continua versionada pelo .gitkeep.
projetos/*/site/uploads/fotos/*
!projetos/*/site/uploads/fotos/.gitkeep

# A Valéria tem repositório próprio (privado) desde 09/08/2026. A pasta
# continua morando aqui para as skills e o CLAUDE.md acharem o contexto, mas
# quem versiona é o git de dentro dela — o MazyOS não duplica.
projetos/Valéria-Augusto/

# O Rafael Gimenez segue a mesma regra, e aqui o motivo é mais forte
# (18/08/2026). Este repositório da raiz é PÚBLICO, e a pasta dele contém:
#   - 40 fotos de antes/depois de pacientes, duas com rosto identificável,
#     sem consentimento levantado (a Resolução CFO-196/2019 exige);
#   - o NOME de um paciente conhecido, nos arquivos de texto, que os próprios
#     arquivos marcam como "não publicar sem autorização explícita".
# Sigilo de paciente não se desfaz: histórico de git é permanente.
# Quem versiona é o git de dentro da pasta dele.
projetos/Rafael-Gimenez/

# Fotos de rosto de cliente (dado pessoal) em qualquer projeto futuro.
# Prefixo `**/` porque a barra no meio do padrão ancoraria na raiz do repo —
# assim casa em qualquer profundidade e continua valendo se a pasta do projeto
# mudar de lugar. Conferir com `git check-ignore -v <arquivo>` depois de mover.
# (A Valéria não depende mais disso: repositório próprio, e as fotos dela já
# eram públicas no Instagram.)
**/fotos-clientes/*
!**/fotos-clientes/.gitkeep

# Credenciais do SMTP (senha de app do Gmail). O modelo sem senha,
# email_config.exemplo.php, é que vai versionado.
# Sem barra no começo: casa em qualquer profundidade, então continua
# valendo se o projeto mudar de pasta de novo.
email_config.php

# Contas exportadas do NutraBalance (banco/exportar_contas.php): e-mail e
# hash de senha de quem se cadastrou. Viaja por pendrive, nunca por commit.
contas_exportadas*.json

# Escritório contábil do pai do Ryan. A pasta carrega carteira de clientes,
# honorários, CNPJ e às vezes CPF — dado de terceiro, sob sigilo profissional
# do contador. O repositório da raiz é público, então nada daqui é versionado
# até o repo virar privado ou o projeto ganhar repositório próprio.
projetos/Escritorio-Contabil/

# Seminovos saiu do repositório público em 26/08/2026, quando a validação
# deixou de ser hipotética: entraram duas lojas reais de Bady Bassitt/SP
# (Portuga Automóveis e M9 Autos) — nome, endereço, telefone do dono e, nas
# entrevistas, o que cada uma fatura e paga de sistema. Dado de empresa e de
# terceiro, dito em conversa particular. O próprio CLAUDE.md do projeto já
# previa essa troca; ela só chegou antes do CPF e da placa.
# Quem versiona agora é o git de dentro da pasta.
projetos/Seminovos/

# Portuga Automóveis — alvo da primeira venda desde 26/08/2026. NÃO é cliente:
# ninguém falou com o dono até 01/09/2026, e a linha anterior aqui dizia
# "cliente pagante", o que nunca foi verdade. Endereço, telefone do dono e, se
# a venda acontecer, acesso ao site dele.
# Mesma regra do Rafael e do Escritório: git próprio dentro da pasta.
projetos/Portuga-Automoveis/
