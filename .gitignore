# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/

# Claude Code (sessões locais, não devem ir pro repo)
.claude/projects/
.claude/sessions/
.claude/shell-snapshots/
.claude/telemetry/
.claude/file-history/
.claude/backups/

# Dependências
node_modules/

# Arquivos temporários
*.log
*.tmp

# Drop zone do usuário (só o README vai versionado)
dados/*
!dados/README.md

# Fotos de perfil enviadas pelos usuários (dado pessoal — não vai pro repo).
# A pasta continua versionada pelo .gitkeep.
site/uploads/fotos/*
!site/uploads/fotos/.gitkeep

# Credenciais do SMTP (senha de app do Gmail). O modelo sem senha,
# email_config.exemplo.php, é que vai versionado.
site/api/email_config.php
